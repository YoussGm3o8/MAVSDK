cmake_minimum_required(VERSION 3.22)
if(NOT GENERATOR OR NOT WORK_DIR)
    message(FATAL_ERROR "GENERATOR and WORK_DIR are required")
endif()
file(MAKE_DIRECTORY "${WORK_DIR}")
set(arguments "")
foreach(kind MINIMAL STANDARD COMMON ARDUPILOTMEGA)
    string(TOLOWER "${kind}" lower)
    set(input "${WORK_DIR}/${lower}.xml")
    file(WRITE "${input}" "<mavlink><description>${lower}</description></mavlink>\n")
    list(APPEND arguments "-D${kind}_XML_PATH=${input}")
endforeach()
set(output "${WORK_DIR}/embedded.hpp")
file(WRITE "${output}" "invalid existing output")

function(generate)
    execute_process(COMMAND "${CMAKE_COMMAND}" ${arguments} "-DOUTPUT_HEADER=${output}" -P "${GENERATOR}"
        RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "XML generation failed")
    endif()
endfunction()

generate()
file(READ "${output}" content)
if(NOT content MATCHES "namespace mav_embedded")
    message(FATAL_ERROR "Corrupt output was not replaced")
endif()
file(SHA256 "${output}" original_hash)
file(TIMESTAMP "${output}" before "%s" UTC)
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1 COMMAND_ERROR_IS_FATAL ANY)
generate()
file(TIMESTAMP "${output}" after "%s" UTC)
file(SHA256 "${output}" repeated_hash)
if(NOT before STREQUAL after OR NOT original_hash STREQUAL repeated_hash)
    message(FATAL_ERROR "Unchanged XML rewrote the generated header")
endif()

file(APPEND "${WORK_DIR}/common.xml" [=[
<!-- ${DO_NOT_EXPAND} @DO_NOT_EXPAND@ ; backslash \ quote " -->
]=])
generate()
file(SHA256 "${output}" changed_hash)
file(READ "${output}" changed_content)
string(FIND "${changed_content}" [=[${DO_NOT_EXPAND}]=] dollar_literal)
string(FIND "${changed_content}" [=[@DO_NOT_EXPAND@]=] at_literal)
if(original_hash STREQUAL changed_hash OR dollar_literal LESS 0 OR at_literal LESS 0)
    message(FATAL_ERROR "Changed XML did not update the generated header")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" ${arguments}
    "-DCOMMON_XML_PATH=${WORK_DIR}/missing.xml" "-DOUTPUT_HEADER=${output}" -P "${GENERATOR}"
    RESULT_VARIABLE missing_result OUTPUT_QUIET ERROR_QUIET)
file(SHA256 "${output}" failure_hash)
if(missing_result EQUAL 0 OR NOT failure_hash STREQUAL changed_hash)
    message(FATAL_ERROR "Missing XML must fail without altering the prior header")
endif()
message(STATUS "Embedded XML regression passed")
